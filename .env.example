# Cluster (default mainnet-beta). Use devnet only via Settings or by setting this to `devnet`.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Primary RPC. Put a Helius (or other) URL in `.env.local` — do not commit keys.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional comma-separated fallbacks tried after the primary when fetching balances.
# NEXT_PUBLIC_SOLANA_RPC_FALLBACKS=https://solana-rpc.publicnode.com
